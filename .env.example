# Copy this file to .env.local for local development, and set the same
# values as Environment Variables in your Vercel project for production.
# See README.md for exactly where to get each of these.

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Optional — defaults to "gpt-5.6-terra" (OpenAI's current balanced tier) if
# unset. Set to "gpt-5.6-luna" for the cheapest/fastest tier, or
# "gpt-5.6-sol" for their most capable tier. Cost either way is a fraction
# of a cent per weekly Generate Week / Generate Report call.
OPENAI_MODEL=gpt-5.6-terra

# --- Airtable --------------------------------------------------------------
AIRTABLE_API_KEY=pat...            # Personal Access Token (starts with "pat")
AIRTABLE_BASE_ID=app...            # Found in the Airtable API docs for your base
AIRTABLE_TABLE_NAME=Posts          # Leave as "Posts" unless you renamed the table
AIRTABLE_DEALS_TABLE_NAME=Deals    # Leave as "Deals" unless you renamed that table

# --- Telegram (optional — real-deal curation via a dedicated bot) ----------
# Leave all three blank to skip this entirely — everything else in the app
# works fine without it. Fill these in to enable: forwarding a deal from
# your existing deal-finding bot to this app's own bot, which turns it into
# on-brand draft posts written from that deal's real price/retailer/link
# (never invented). See README section 9 for full setup (creating the bot
# via BotFather, finding your own Telegram user ID, and registering the
# webhook).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- Metricool (optional — needs their paid Advanced plan) -----------------
# Leave all three blank to start free: approving a post just marks it
# approved with a note to schedule it yourself, and /report switches to a
# manual numbers-entry form. Fill these in later to switch both over to
# fully automatic — see README section 4. Metricool's API uses a static
# account token, not OAuth.
METRICOOL_API_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=

# --- App auth ---------------------------------------------------------------
# Simple HTTP Basic Auth that protects every page and API route. Pick your
# own values — this is the username/password you'll type once in the browser.
APP_BASIC_AUTH_USER=founder
APP_BASIC_AUTH_PASSWORD=change-me

# --- Optional: report emailing ---------------------------------------------
# The app builds a mailto: link for the weekly report by default (no extra
# setup needed). This address is just what it's pre-addressed to. Must use
# the NEXT_PUBLIC_ prefix since it's read in the browser, not the server.
NEXT_PUBLIC_REPORT_EMAIL_TO=you@dealradaruk.com
